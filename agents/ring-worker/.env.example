# Kinwise Ring worker — copy to `.env` (git-ignored) and fill in. Never commit real tokens.

# ── Kinwise hub ──
HUB_URL=http://localhost:8787
INGEST_SECRET=dev-ingest-secret
HOUSEHOLD_ID=hh-asha

# ── Ring Partner API ──
RING_API_BASE=https://api.amazonvision.com

# Option A: Ring Developer Playground (token lasts ~30 minutes).
# Paste the token into ring-token.txt (git-ignored); the worker re-reads it when it changes.
RING_TOKEN_FILE=ring-token.txt
# RING_TOKEN=

# Option B: linked device (OAuth refresh-token flow; takes precedence when all three are set).
# RING_CLIENT_ID=
# RING_CLIENT_SECRET=
# RING_REFRESH_TOKEN=
# RING_OAUTH_URL=https://oauth.ring.com/oauth/token

# Comma-separated device ids; leave empty to discover them with GET /v1/devices.
RING_DEVICE_IDS=

# Shared secret for webhook HMAC verification (webhook mode only).
RING_WEBHOOK_SECRET=

# ── Timing ──
POLL_SECONDS=5
LIVE_EVERY_SECONDS=20
PERSON_COOLDOWN_SECONDS=60

# ── Perception ──
# bedrock | offline (default: bedrock when AWS credentials are found, else offline)
# PERCEPTION_MODE=bedrock
PERCEPTION_MODEL_ID=us.amazon.nova-2-lite-v1:0
AWS_REGION=us-east-1
# Fraction of the frame height cropped from the top (Ring watermark band) before analysis.
WATERMARK_CROP=0.15

# Local state (seen event ids, rotated refresh token). Git-ignored.
STATE_DIR=.kinwise-data
