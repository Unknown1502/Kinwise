{
  "name": "alexa-plus-mcp-kit",
  "version": "0.1.0",
  "description": "Make a self-hosted MCP server speak Alexa+'s add-on auth contract: two-tier OAuth scopes, RFC 9728 metadata, Alexa-compatible 401s, Origin checks, plus a conformance checker.",
  "license": "Apache-2.0",
  "type": "module",
  "keywords": ["alexa", "alexa-plus", "mcp", "model-context-protocol", "oauth", "rfc9728", "streamable-http"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "alexa-mcp-conformance": "./dist/cli.js"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "@types/node": "^22.10.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "zod": "^4.2.0"
  }
}
