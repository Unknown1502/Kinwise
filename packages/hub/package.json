{
  "name": "@kinwise/hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Kinwise hub: safety rules engine, Alexa+ MCP server (2025-11-25, Streamable HTTP), Fire TV API and event ingestion",
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build:ui": "node ui/build.mjs",
    "build": "npm run build:ui && tsc -p tsconfig.build.json",
    "bundle:lambda": "npm run build:ui && node scripts/bundle-lambda.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "conformance": "tsx scripts/conformance.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-agentcore": "^3.900.0",
    "@aws-sdk/client-dynamodb": "^3.900.0",
    "@aws-sdk/client-sns": "^3.900.0",
    "@aws-sdk/lib-dynamodb": "^3.900.0",
    "@hono/node-server": "^1.19.0",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@modelcontextprotocol/server": "^2.3.1",
    "aws-jwt-verify": "^5.2.1",
    "hono": "^4.10.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^3.2.0"
  }
}
