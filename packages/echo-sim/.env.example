# Kinwise Echo Show simulator — copy to .env.local to override the defaults.
# Hub base URL (the self-hosted Kinwise MCP server + /sim/ask bridge)
VITE_HUB_URL=http://localhost:8787
# Dev bearer tokens (hub AUTH_MODE=dev). In cognito mode, paste real access tokens.
VITE_ASHA_TOKEN=dev-asha
VITE_PRIYA_TOKEN=dev-priya
