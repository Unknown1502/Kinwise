{
  "name": "@kinwise/tv-preview",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser preview of the Kinwise Fire TV app (packages/tv-app/src) via react-native-web. Development only: the real app runs on Vega OS.",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native-web": "~0.21.2",
    "react-tv-space-navigation": "5.2.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^18.2.79",
    "@types/react-dom": "^18.2.25",
    "@types/react-native": "0.72.8",
    "@vitejs/plugin-react": "^5.1.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=22"
  }
}
